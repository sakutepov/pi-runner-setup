[Unit]
Description=GitHub Actions Runner for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart="__RUNNER_DIR__/runsvc.sh"
WorkingDirectory="__RUNNER_DIR__"
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
Restart=always
RestartSec=5s
User=__USER__
Environment="DOTNET_CLI_TELEMETRY_OPTOUT=1"
Environment="GITHUB_ACTIONS_RUNNER_DEBUG=0"

[Install]
WantedBy=multi-user.target
