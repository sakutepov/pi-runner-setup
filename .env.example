# A fine-grained PAT limited to the repositories in repos.txt.
# Required repository permission: Administration (read and write).
# Treat this file as a trusted Bash script; protect it with chmod 600.
GITHUB_PAT=ghp_your_personal_access_token_here

# Bootstrap version of actions/runner (separate from this project's version).
RUNNER_VERSION=2.337.0

# arm64 for 64-bit Raspberry Pi OS; x64 for x86_64 Linux.
# amd64/x86_64 and aarch64 aliases are also accepted.
ARCH=arm64

# Official SHA-256 checksums for 2.337.0/arm64 and x64 are built in.
# When selecting another runner version, supply its published checksum here.
RUNNER_SHA256=

# Extra workflow routing labels; GitHub adds self-hosted/Linux/architecture labels.
LABELS="raspberry-pi"

LANG=C.UTF-8
